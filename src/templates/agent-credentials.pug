doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Agent Credentials
    style.
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }
      .header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #ffffff;
        padding: 30px;
        text-align: center;
      }
      .header h1 {
        margin: 0;
        font-size: 28px;
      }
      .content {
        padding: 30px;
      }
      .content h2 {
        color: #333333;
        font-size: 22px;
        margin-top: 0;
      }
      .content p {
        color: #666666;
        font-size: 16px;
        line-height: 1.6;
      }
      .credentials-box {
        background-color: #f8f9fa;
        border-left: 4px solid #667eea;
        padding: 20px;
        margin: 25px 0;
        border-radius: 5px;
      }
      .credentials-box p {
        margin: 10px 0;
        font-size: 16px;
      }
      .credentials-box strong {
        color: #333333;
        display: inline-block;
        min-width: 100px;
      }
      .credentials-box .password {
        background-color: #ffffff;
        padding: 10px 15px;
        border-radius: 4px;
        border: 1px dashed #667eea;
        font-family: 'Courier New', monospace;
        font-size: 18px;
        color: #667eea;
        font-weight: bold;
        display: inline-block;
        margin-top: 5px;
      }
      .button {
        display: inline-block;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #ffffff;
        text-decoration: none;
        padding: 14px 30px;
        border-radius: 5px;
        font-size: 16px;
        font-weight: 600;
        margin: 20px 0;
      }
      .warning {
        background-color: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 15px;
        margin: 20px 0;
        border-radius: 5px;
      }
      .warning p {
        color: #856404;
        margin: 0;
        font-size: 14px;
      }
      .footer {
        background-color: #f8f9fa;
        padding: 20px;
        text-align: center;
        color: #999999;
        font-size: 14px;
      }
  body
    .container
      .header
        h1 🎉 Account Approved!
      .content
        h2 Hello #{name}!
        p Congratulations! Your agent account has been approved by our admin team.
        p You can now access the MGM agent portal using your credentials below:
        
        .credentials-box
          p
            strong Email:
            span #{email}
          p
            strong Password:
            br
            span.password #{password}
        
        .warning
          p ⚠️ <strong>Security Notice:</strong> Please change your password immediately after your first login for security purposes.
        
        if loginUrl
          p
            a.button(href=loginUrl, target='_blank') Login to Agent Portal
        else
          p
            a.button(href='#') Login to Agent Portal
        
        p If you have any questions or need assistance, please don't hesitate to contact our support team.
        
        p
          | Best regards,
          br
          | <strong>The MGM Team</strong>
      
      .footer
        p © #{new Date().getFullYear()} MGM. All rights reserved.
        p This is an automated email. Please do not reply to this message.

